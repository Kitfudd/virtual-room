# Normalize line endings to LF in the repository and in working copies,
# so files are identical on Windows and on the Linux CI runners.
* text=auto eol=lf

# Binary web assets, stored in normal Git. Web-sized content images
# (content/, public/) excluded from LFS so CI never needs to download LFS files.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.glb   binary
*.ktx2  binary
*.woff  binary
*.woff2 binary
*.mp3   binary
*.ogg   binary
*.mp4   binary
*.webm  binary

# Art sources under art/, stored in Git LFS.
# These lines come after the binary lines above, so they take precedence.
art/**/*.blend filter=lfs diff=lfs merge=lfs -text
art/**/*.psd   filter=lfs diff=lfs merge=lfs -text
art/**/*.kra   filter=lfs diff=lfs merge=lfs -text
art/**/*.exr   filter=lfs diff=lfs merge=lfs -text
art/**/*.hdr   filter=lfs diff=lfs merge=lfs -text
art/**/*.png   filter=lfs diff=lfs merge=lfs -text
art/**/*.jpg   filter=lfs diff=lfs merge=lfs -text
art/**/*.jpeg  filter=lfs diff=lfs merge=lfs -text
art/**/*.tif   filter=lfs diff=lfs merge=lfs -text
art/**/*.tiff  filter=lfs diff=lfs merge=lfs -text
art/**/*.fbx   filter=lfs diff=lfs merge=lfs -text
